{
  "id": "frontend-check",
  "purpose": "Run the explicit and changed frontend unit/regression files against the retained candidate in owned scratch with immutable configured dependencies.",
  "inputs": {
    "patch": "artifact",
    "tests": "text"
  },
  "outputs": {
    "check": "text",
    "artifact": "artifact"
  },
  "execution": {
    "harness": "command",
    "access": "workspace-read",
    "command": {
      "args": [
        "/absolute/path/to/runner-frontend-check",
        "--node",
        "/absolute/path/to/node",
        "--modules",
        "/absolute/path/to/frontend-node-modules",
        "--source",
        "{workspace}",
        "--scratch",
        "{scratch}",
        "--tests",
        "{frontend.tests}"
      ],
      "result": "domain.json",
      "artifact": "frontend-check.json"
    }
  }
}
