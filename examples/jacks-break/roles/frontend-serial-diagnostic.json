{
  "id": "frontend-serial-diagnostic",
  "purpose": "Collect frontend diagnostic evidence from an exact retained patch with one Vitest worker and a five-second case timeout.",
  "inputs": {
    "patch": "artifact",
    "tests": "text",
    "test_name": "text"
  },
  "outputs": {
    "check": "text",
    "artifact": "artifact"
  },
  "execution": {
    "harness": "command",
    "access": "workspace-read",
    "command": {
      "args": [
        "/absolute/path/to/runner-frontend-check",
        "--node",
        "/absolute/path/to/node",
        "--modules",
        "/absolute/path/to/frontend-node-modules",
        "--source",
        "{workspace}",
        "--scratch",
        "{scratch}",
        "--tests",
        "{text.tests}",
        "--serial",
        "--test-name",
        "{text.test_name}"
      ],
      "result": "domain.json",
      "artifact": "frontend-check.json"
    }
  }
}
