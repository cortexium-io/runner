{
  "id": "planned-investigation-measure",
  "purpose": "Measure one planned investigation round; retain incomplete collection diagnostics and request only bounded stdout-overflow correction.",
  "inputs": {
    "patch": "artifact",
    "package": "text",
    "benchmark": "text",
    "previous": "text"
  },
  "outputs": {
    "check": "text",
    "artifact": "artifact"
  },
  "execution": {
    "harness": "command",
    "access": "workspace-read",
    "command": {
      "args": [
        "/absolute/path/to/runner-measure",
        "--go",
        "/absolute/path/to/go",
        "--source",
        "{workspace}",
        "--scratch",
        "{scratch}",
        "--package",
        "{text.package}",
        "--benchmark",
        "{text.benchmark}",
        "--previous",
        "{text.previous}",
        "--repair-collection"
      ],
      "env": {
        "GOMODCACHE": "/absolute/path/to/module-cache"
      },
      "result": "domain.json",
      "artifact": "measurements.json"
    }
  }
}
