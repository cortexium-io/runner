{
  "id": "deliver-retained-catalogue",
  "inputs": {
    "request": "text",
    "package": "text",
    "tests": "text",
    "frontend_tests": "text",
    "publication": "json",
    "patch": "artifact"
  },
  "steps": [
    {
      "id": "source-adopt",
      "role": "delivery-source-adopt",
      "inputs": {
        "receipt": {
          "from_input": "publication"
        },
        "patch": {
          "from_input": "patch"
        }
      },
      "routes": {
        "ready": {
          "next": "admit"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "admit",
      "role": "delivery-readiness",
      "inputs": {},
      "routes": {
        "ready": {
          "next": "owner"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "owner",
      "role": "catalogue-owner",
      "inputs": {
        "request": {
          "from_input": "request"
        },
        "frontend_tests": {
          "from_input": "frontend_tests"
        },
        "frontend_check": {
          "from_step": "frontend-check",
          "output": "check",
          "previous": true,
          "default": {
            "inline": ""
          }
        },
        "check": {
          "from_step": "check",
          "output": "check",
          "previous": true,
          "default": {
            "inline": ""
          }
        },
        "review": {
          "from_step": "review",
          "output": "summary",
          "previous": true,
          "default": {
            "inline": ""
          }
        },
        "qualification": {
          "from_step": "qualify",
          "output": "receipt",
          "previous": true,
          "default": {
            "inline": {}
          }
        }
      },
      "routes": {
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "frontend-check",
      "role": "frontend-check",
      "inputs": {
        "patch": {
          "from_candidate": true
        },
        "tests": {
          "from_input": "frontend_tests"
        }
      },
      "routes": {
        "ready": {
          "next": "check"
        },
        "changes_requested": {
          "next": "owner",
          "max_times": 1
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "check",
      "role": "planned-go-check",
      "inputs": {
        "patch": {
          "from_candidate": true
        },
        "package": {
          "from_input": "package"
        },
        "tests": {
          "from_input": "tests"
        }
      },
      "routes": {
        "ready": {
          "next": "review"
        },
        "changes_requested": {
          "next": "owner",
          "max_times": 1
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "review",
      "role": "catalogue-review",
      "inputs": {
        "request": {
          "from_input": "request"
        },
        "patch": {
          "from_candidate": true
        },
        "summary": {
          "from_step": "owner",
          "output": "summary"
        },
        "go_checks": {
          "from_step": "check",
          "output": "artifact"
        },
        "frontend_checks": {
          "from_step": "frontend-check",
          "output": "artifact"
        }
      },
      "routes": {
        "ready": {
          "next": "integrate"
        },
        "changes_requested": {
          "next": "owner",
          "max_times": 1
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "integrate",
      "role": "delivery-integrate",
      "inputs": {
        "patch": {
          "from_candidate": true
        },
        "verdict": {
          "from_step": "review",
          "output": "verdict"
        },
        "review": {
          "from_step": "review",
          "output": "summary"
        }
      }
    },
    {
      "id": "publish",
      "role": "delivery-publish",
      "inputs": {
        "candidate": {
          "from_step": "integrate",
          "output": "candidate"
        },
        "previous": {
          "from_step": "publish",
          "output": "receipt",
          "previous": true,
          "fallback": {
            "from_step": "source-adopt",
            "output": "receipt"
          }
        }
      },
      "routes": {
        "ready": {
          "next": "qualify"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "qualify",
      "role": "delivery-qualify",
      "inputs": {
        "receipt": {
          "from_step": "publish",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "prepare"
        },
        "changes_requested": {
          "next": "owner",
          "max_times": 1
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "prepare",
      "role": "delivery-prepare",
      "inputs": {
        "receipt": {
          "from_step": "qualify",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "merge",
          "approval": true
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "merge",
      "role": "delivery-merge",
      "inputs": {
        "receipt": {
          "from_step": "prepare",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "backup"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "backup",
      "role": "delivery-backup",
      "inputs": {
        "receipt": {
          "from_step": "merge",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "stop",
          "approval": true
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "stop",
      "role": "delivery-stop",
      "inputs": {
        "receipt": {
          "from_step": "backup",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "migrate"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "migrate",
      "role": "delivery-migrate",
      "inputs": {
        "receipt": {
          "from_step": "stop",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "pin"
        },
        "blocked": {
          "next": "$fail"
        },
        "recovery_required": {
          "next": "inspect-migration"
        }
      }
    },
    {
      "id": "inspect-migration",
      "role": "delivery-inspect-migration",
      "inputs": {
        "receipt": {
          "from_step": "migrate",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "restore",
          "approval": true
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "restore",
      "role": "delivery-restore",
      "inputs": {
        "receipt": {
          "from_step": "inspect-migration",
          "output": "receipt"
        }
      },
      "routes": {
        "restored": {
          "next": "$fail"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "pin",
      "role": "delivery-pin",
      "inputs": {
        "receipt": {
          "from_step": "migrate",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "deploy"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "deploy",
      "role": "delivery-deploy",
      "inputs": {
        "receipt": {
          "from_step": "pin",
          "output": "receipt"
        },
        "recovery": {
          "from_step": "inspect",
          "output": "receipt",
          "previous": true,
          "default": {
            "inline": {}
          }
        },
        "previous": {
          "from_step": "deploy",
          "output": "receipt",
          "previous": true,
          "default": {
            "inline": {}
          }
        }
      },
      "routes": {
        "ready": {
          "next": "verify-live"
        },
        "blocked": {
          "next": "$fail"
        },
        "retry_safe": {
          "next": "deploy",
          "max_times": 1
        },
        "recovery_required": {
          "next": "inspect"
        }
      }
    },
    {
      "id": "inspect",
      "role": "delivery-inspect",
      "inputs": {
        "receipt": {
          "from_step": "deploy",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "deploy",
          "approval": true,
          "max_times": 1
        },
        "blocked": {
          "next": "$fail"
        }
      }
    },
    {
      "id": "verify-live",
      "role": "delivery-verify",
      "inputs": {
        "receipt": {
          "from_step": "deploy",
          "output": "receipt"
        }
      },
      "routes": {
        "ready": {
          "next": "$complete"
        },
        "blocked": {
          "next": "$fail"
        }
      }
    }
  ],
  "outputs": {
    "receipt": {
      "from_step": "verify-live",
      "output": "receipt"
    }
  },
  "max_attempts": 28,
  "max_attempts_per_step": 1,
  "attempt_timeout": "20m",
  "infrastructure_retries": 1
}
