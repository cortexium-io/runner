<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cortexium.runner.example</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/private/pilot/cortexium-runner</string>
    <string>serve</string>
    <string>--config</string>
    <string>/absolute/private/pilot/config/instance.json</string>
    <string>--data</string>
    <string>/absolute/private/pilot/state</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/absolute/private/pilot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/absolute/private/pilot/coordinator/service/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/private/pilot/coordinator/service/stderr.log</string>
</dict>
</plist>
