{
  "id": "local-browser",
  "purpose": "Reproduce the independently reviewed local build and observe the fixed first-flow journeys on owned synthetic state.",
  "inputs": {
    "patch": "artifact",
    "authority": "artifact",
    "checks": "artifact",
    "verdict": "text"
  },
  "outputs": {
    "check": "text",
    "artifact": "artifact"
  },
  "execution": {
    "harness": "command",
    "access": "workspace-read",
    "command": {
      "args": [
        "/absolute/path/to/runner-saas-check",
        "--source",
        "{workspace}",
        "--scratch",
        "{scratch}",
        "--authority",
        "{input.authority}",
        "--base",
        "{source.base}",
        "--patch",
        "{input.patch}",
        "--runtime",
        "/absolute/path/to/saas-runtime.json",
        "--browser",
        "--checks",
        "{input.checks}",
        "--source-verdict",
        "{text.verdict}",
        "--patch-id",
        "{artifact_id.patch}"
      ],
      "network": true,
      "artifact": "evidence.tar.gz",
      "result": "domain.json"
    }
  }
}
