{
  "id": "verify",
  "purpose": "Run only the explicitly selected Go package/test scope against the retained candidate, without a model or network.",
  "inputs": {
    "patch": "artifact",
    "package": "text",
    "tests": "text"
  },
  "outputs": {
    "check": "text"
  },
  "execution": {
    "harness": "command",
    "access": "workspace-read",
    "command": {
      "args": [
        "/absolute/path/to/go",
        "test",
        "-mod=readonly",
        "./{text.package}",
        "-run",
        "{text.tests}"
      ]
    }
  }
}
