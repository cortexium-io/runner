{
  "id": "reviewed-go",
  "name": "Reviewed Go development",
  "workspace": "/absolute/path/to/project",
  "source": {
    "ref": "HEAD"
  },
  "default_process": "develop",
  "roles": {
    "implement": {
      "file": "roles/implement.json"
    },
    "verify": {
      "file": "roles/verify.json"
    },
    "review": {
      "file": "roles/review.json"
    },
    "integrate": {
      "file": "roles/integrate.json"
    },
    "owner": {
      "file": "roles/owner.json"
    },
    "verify-iterative": {
      "file": "roles/verify-iterative.json"
    },
    "measure": {
      "file": "roles/measure.json"
    },
    "review-iterative": {
      "file": "roles/review-iterative.json"
    },
    "deliver": {
      "file": "roles/deliver.json"
    },
    "plan": {
      "file": "roles/plan.json"
    }
  },
  "processes": {
    "develop": "processes/develop.json",
    "develop-iterative": "processes/develop-iterative.json",
    "develop-tasks": "processes/develop-tasks.json"
  }
}
