{
  "id": "write",
  "inputs": {"request": "text"},
  "tasks": {
    "roles": ["writing-author", "writing-critic", "writing-challenger"],
    "max_tasks": 8,
    "max_depth": 3,
    "max_revisions": 3,
    "max_concurrent": 2
  },
  "max_attempts": 24,
  "max_attempts_per_step": 3,
  "infrastructure_retries": 1,
  "attempt_timeout": "15m",
  "steps": [
    {
      "id": "lead",
      "role": "writing-lead",
      "inputs": {"request": {"from_input": "request"}}
    }
  ],
  "outputs": {"result": {"from_step": "lead", "output": "report"}}
}
