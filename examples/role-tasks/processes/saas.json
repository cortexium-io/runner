{
  "id": "build-saas",
  "inputs": {
    "request": "text"
  },
  "tasks": {
    "roles": [
      "saas-planner",
      "saas-initializer",
      "saas-backend",
      "saas-frontend",
      "saas-integrator",
      "saas-fixed-check",
      "saas-repair"
    ],
    "max_tasks": 10,
    "max_depth": 3,
    "max_revisions": 0,
    "max_concurrent": 2
  },
  "max_attempts": 48,
  "max_attempts_per_step": 3,
  "infrastructure_retries": 1,
  "attempt_timeout": "25m",
  "steps": [
    {
      "id": "lead",
      "role": "saas-lead",
      "inputs": {
        "request": {
          "from_input": "request"
        }
      },
      "routes": {
        "accepted": {
          "next": "$complete"
        },
        "rejected": {
          "next": "$fail"
        },
        "ready": {
          "next": "$fail"
        }
      }
    }
  ],
  "outputs": {
    "result": {
      "from_step": "lead",
      "output": "report"
    }
  }
}
